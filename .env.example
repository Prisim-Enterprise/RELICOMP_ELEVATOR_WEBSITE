# SMTP (Contact / lead forms) – server-side only. Copy to .env.local and fill in.
# These are never exposed to the browser. Restart the dev server after adding: npm run dev
#
# Example (common providers):
#   Gmail App Password:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   Zoho / workspace:    use your provider’s SMTP host and port (often 465 or 587)
#
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM="Relicomp Elevators <you@example.com>"
# Comma-separated list — one email is delivered to all recipients
SMTP_TO=support@relicompelevators.in,sales@relicompelevators.in

# Canonical site origin (no trailing slash). Required in production (Vercel env).
# Production decision (2026-07-11): https://www.relicompelevator.com
# Also set redirects from relicompelevators.in / apex variants → this host in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.relicompelevator.com
